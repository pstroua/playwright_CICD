pipeline {
    agent {
        docker{
            image 'mcr.microsoft.com/playwright:v1.65.0-jammy'
            args '-u root --entrypoint='
        }
    }

    parameters {
        booleanParam(name: 'istag', defaultValue: true, description: 'lancer avec tous les tag ?')
        choice(name: 'tag', choices: ['@smoke', '@TNR'], description: 'Choisir un tag')
     }
    stages {
         stage('Check version nodejs') {
            steps {
                sh 'npm --version'
            }
        }
        stage('installation dependances') {
            steps {
                sh 'npm install'
            }
        }
        stage('Lancer le test') {
            steps {
                script{
                      if(params.istag == true){
                        sh "npx playwright test --grep=${params.tag}"
                    } else {
                        sh"npx playwright test"
                    }
                }
            }
        }
       
         
    }
} 

